# CareerPilot local runtime example. This file is documentation; Maven/Spring does not load it automatically.
CAREERPILOT_AI_ENABLED=false
# Resume Review vector retrieval is separately opt-in and requires AI to be enabled.
CAREERPILOT_RAG_ENABLED=false
# Calibrated against the bundled four-chunk synthetic guide; override only after retrieval evaluation.
CAREERPILOT_RAG_SIMILARITY_THRESHOLD=0.50
DASHSCOPE_API_KEY=

# Application-level Clerk authentication is default-off until issuer and authorized parties are configured.
CAREERPILOT_CLERK_AUTH_ENABLED=false
# Temporary compatibility alias for the earlier feature-scoped authentication build.
CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED=false
CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED=false
CAREERPILOT_PUBLIC_RAG_GUARD_ENABLED=false
CAREERPILOT_PUBLIC_RAG_DAILY_USER_LIMIT=3
CAREERPILOT_PUBLIC_RAG_DAILY_GLOBAL_LIMIT=100
CAREERPILOT_PUBLIC_RAG_MAX_CONCURRENT_REQUESTS=2
CAREERPILOT_PUBLIC_RAG_MAX_INPUT_TOKENS=6000
CAREERPILOT_PUBLIC_RAG_MAX_OUTPUT_TOKENS=800
CAREERPILOT_PUBLIC_RAG_MAX_TOTAL_TOKENS=6800
CAREERPILOT_PUBLIC_RAG_GUARD_HMAC_SECRET=
CAREERPILOT_CLERK_ISSUER=
CAREERPILOT_CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Set these only when the local defaults do not match your PostgreSQL setup.
CAREERPILOT_DB_URL=jdbc:postgresql://localhost:5433/careerpilot
CAREERPILOT_DB_USERNAME=careerpilot_app
CAREERPILOT_DB_PASSWORD=
CAREERPILOT_DB_MIGRATION_ENABLED=false

# Development frontend origin.
CAREERPILOT_CORS_ALLOWED_ORIGINS=http://localhost:3000
