# CareerPilot local runtime example. This file is documentation; Maven/Spring does not load it automatically.
CAREERPILOT_AI_ENABLED=false
# Resume Review vector retrieval is separately opt-in and requires AI to be enabled.
CAREERPILOT_RAG_ENABLED=false
# Calibrated against the bundled four-chunk synthetic guide; override only after retrieval evaluation.
CAREERPILOT_RAG_SIMILARITY_THRESHOLD=0.50
DASHSCOPE_API_KEY=

# Set these only when the local defaults do not match your PostgreSQL setup.
CAREERPILOT_DB_URL=jdbc:postgresql://localhost:5432/careerpilot
CAREERPILOT_DB_USERNAME=careerpilot_app
CAREERPILOT_DB_PASSWORD=
CAREERPILOT_DB_MIGRATION_ENABLED=false

# Development frontend origin.
CAREERPILOT_CORS_ALLOWED_ORIGINS=http://localhost:3000
