# Application-level Google-only Clerk authentication is disabled by default.
VITE_CAREERPILOT_AUTH_ENABLED=false
# Temporary compatibility alias for the earlier feature-scoped authentication build.
VITE_CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED=false
# PUBLIC-UPLOAD-01 also requires PUBLIC-AUTH-01 and remains disabled by default.
VITE_CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED=false
# Clerk publishable keys are designed for browser use; never place a Clerk secret key here.
VITE_CLERK_PUBLISHABLE_KEY=
