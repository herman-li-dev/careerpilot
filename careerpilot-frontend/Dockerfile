FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_CAREERPILOT_DEMO_MODE=false
ARG VITE_CAREERPILOT_AUTH_ENABLED=false
ARG VITE_CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED=false
ARG VITE_CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED=false
ARG VITE_CLERK_PUBLISHABLE_KEY=
ENV VITE_CAREERPILOT_DEMO_MODE=${VITE_CAREERPILOT_DEMO_MODE}
ENV VITE_CAREERPILOT_AUTH_ENABLED=${VITE_CAREERPILOT_AUTH_ENABLED}
ENV VITE_CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED=${VITE_CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED}
ENV VITE_CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED=${VITE_CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED}
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
ENV CAREERPILOT_CLERK_ISSUER=""
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY proxy_params /etc/nginx/proxy_params
COPY proxy_public_rag_params /etc/nginx/proxy_public_rag_params
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
