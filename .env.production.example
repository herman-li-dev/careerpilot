CAREERPILOT_DB_NAME=careerpilot
CAREERPILOT_DB_USER=careerpilot
CAREERPILOT_DB_PASSWORD=
CAREERPILOT_JWT_SECRET=
# The public demo must keep provider calls and vector retrieval disabled.
CAREERPILOT_AI_ENABLED=false
CAREERPILOT_RAG_ENABLED=false
DASHSCOPE_API_KEY=
CAREERPILOT_RAG_SIMILARITY_THRESHOLD=0.50
# Keep Clerk application authentication off until the production instance is Google-only and configured.
CAREERPILOT_CLERK_AUTH_ENABLED=false
# Temporary compatibility alias for the earlier feature-scoped authentication build.
CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED=false
CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED=false
CAREERPILOT_PUBLIC_RAG_GUARD_ENABLED=false
CAREERPILOT_PUBLIC_RAG_DAILY_USER_LIMIT=3
CAREERPILOT_PUBLIC_RAG_DAILY_GLOBAL_LIMIT=100
CAREERPILOT_PUBLIC_RAG_MAX_CONCURRENT_REQUESTS=2
CAREERPILOT_PUBLIC_RAG_MAX_INPUT_TOKENS=6000
CAREERPILOT_PUBLIC_RAG_MAX_OUTPUT_TOKENS=800
CAREERPILOT_PUBLIC_RAG_MAX_TOTAL_TOKENS=6800
CAREERPILOT_PUBLIC_RAG_GUARD_HMAC_SECRET=
CAREERPILOT_CLERK_ISSUER=
CAREERPILOT_CLERK_AUTHORIZED_PARTIES=https://careerpilot.example.com
VITE_CAREERPILOT_PUBLIC_RAG_AUTH_ENABLED=false
VITE_CAREERPILOT_AUTH_ENABLED=false
VITE_CAREERPILOT_PUBLIC_RAG_UPLOAD_ENABLED=false
VITE_CLERK_PUBLISHABLE_KEY=
CAREERPILOT_PUBLIC_ORIGIN=https://careerpilot.example.com
CAREERPILOT_AUTH_COOKIE_SECURE=true
CAREERPILOT_HTTP_PORT=18080
